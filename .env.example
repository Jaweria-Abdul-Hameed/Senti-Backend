# Copy this file to .env and fill in real values. Load it with `python-dotenv`
# or export these in your shell before running uvicorn.

# Same key name the Kotlin app used to read from BuildConfig.GEMINI_API_KEY —
# it now lives only here, server-side, never inside the APK.
GEMINI_API_KEY=your-real-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Postgres connection. Defaults to the same local dev DB your original
# database.py pointed at if you don't set this.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/senti_db

SQL_ECHO=false

# Signs/verifies JWT access + password-reset tokens (security.py). Generate
# a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random one is generated per-process (all tokens invalidated on restart).
JWT_SECRET_KEY=

# The WEB client ID (not Android client ID) from Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth 2.0 Client IDs. Used both as the
# Android app's serverClientId when requesting a Google ID token, and here
# on the backend to verify that token was really issued for your app.
GOOGLE_CLIENT_ID=

# --- Nearby crisis resources map (routers/resources.py) ---
# Free API key, no credit card required: sign up at
# https://myprojects.geoapify.com, create a project, copy the key it gives
# you. Free tier is 3000 requests/day, plenty for dev + demo use.
GEOAPIFY_API_KEY=


# --- Password reset emails (email_service.py) ---
# Without these, forgot-password still "works" but the reset code only
# shows up in the server log, not an actual email.
#
# Easiest option: a Gmail account with an "App Password" (NOT your normal
# Gmail password — Google blocks that for SMTP). Create one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be enabled on the account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_USE_TLS=true
